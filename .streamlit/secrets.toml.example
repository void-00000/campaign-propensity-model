# Template for Streamlit secrets. COPY this file to secrets.toml and fill it in.
#
#     copy .streamlit\secrets.toml.example .streamlit\secrets.toml
#
# secrets.toml is git-ignored. This .example file is committed so anyone
# cloning the repo knows what they need to provide, without you ever having
# committed a real password.
#
# ---------------------------------------------------------------------------
# LOCAL USE: you don't need this file at all. src/config.py falls back to the
# .env credentials for your Docker container automatically.
#
# STREAMLIT CLOUD: you don't create this file there either. Paste the same
# contents into the app's Settings -> Secrets box in the Streamlit UI. This
# file is only for testing the cloud database from your own machine.
# ---------------------------------------------------------------------------

# Your Neon connection string. Get it from the Neon dashboard:
#   Project -> Connection Details -> copy the "psql" / connection string
#
# It looks like this (the ?sslmode=require matters -- Neon rejects plaintext):
DATABASE_URL = "postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
